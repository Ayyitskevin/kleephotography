# Copy to /opt/mise/.env, chmod 600, owner mise.
# Generate the secret:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MISE_SECRET_KEY=CHANGE_ME
MISE_ADMIN_PASSWORD=CHANGE_ME
MISE_BASE_URL=https://kleephotography.com
MISE_SITE_NAME=Kevin Lee Photography
# Defense-in-depth canonical browser redirect. Leave false until the trusted
# proxy and edge checks in ops/TRUTHFUL-HTTPS.md pass; only the edge can protect
# a direct HTTP POST before it reaches the origin.
MISE_CANONICAL_REDIRECTS=false
# Uvicorn may honor forwarded scheme data only from the local Cloudflare tunnel.
# Confirm cloudflared is the loopback peer and preserves the visitor Host first.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Secure cookies auto-enable when MISE_BASE_URL is https, so you normally don't
# need this line in production. Only set it to override (e.g. force off in a
# non-TLS staging box). Leaving a stale "=false" here on an https deploy DISABLES
# Secure cookies — delete the line or set true.
# MISE_COOKIE_SECURE=true
# Public marketing (optional)
# MISE_INSTAGRAM_URL=https://www.instagram.com/your-handle/
# MISE_GOOGLE_BUSINESS_URL=https://g.page/your-business
# Studio portrait on /about — drop the file in /static (or set the name):
# MISE_ABOUT_PORTRAIT=about-portrait.jpg
# Kill switches (both default on): the Screening Room look, and the Aerial
# Pass offering (band, $150 booking add-on, ticker/credits copy, ▲ badges).
# MISE_SCREENING_ROOM=false
# MISE_AERIALS_LIVE=false
MISE_PLAUSIBLE_DOMAIN=kleephotography.com
# Sample gallery for prospects — slug auto-detected if unset (title/slug contains "sample")
# MISE_DEMO_GALLERY_SLUG=sample-tasting-menu
# MISE_DEMO_GALLERY_PIN=1234

# ── Integrations (all optional; each feature stays dormant until its keys are set) ──
# Stripe Checkout + webhook (invoice pay page). Webhook secret from the CLI/dashboard.
# MISE_STRIPE_SECRET_KEY=sk_live_xxx
# MISE_STRIPE_WEBHOOK_SECRET=whsec_xxx
# Gmail SMTP for manual document sends (use a Google app password, not your login).
# MISE_GMAIL_USER=you@gmail.com
# MISE_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Notion one-way status sync (invoice sent/paid → Session page).
# MISE_NOTION_TOKEN=ntn_xxx
# MISE_NOTION_SESSIONS_DB=
# MISE_NOTION_BOOKINGS_DB=
# One-way inquiry→Notion Leads mirror (unset = dormant; store + email still work).
# MISE_NOTION_LEADS_DB=
# Google Calendar OAuth (scheduling availability). Calendar id defaults to "primary".
# MISE_GOOGLE_CLIENT_ID=
# MISE_GOOGLE_CLIENT_SECRET=
# MISE_GOOGLE_CALENDAR_ID=primary
# When connected: free/busy failures hide slots / reject bookings (default: off = fail-open).
# MISE_GCAL_AVAILABILITY_STRICT=false
# Odysseus caption AI hand-off (admin "draft caption" button).
# MISE_ODYSSEUS_CAPTION_URL=
# MISE_ODYSSEUS_CAPTION_TOKEN=
# Bearer token that arms the read-only shot-list API for Odysseus preshoot packs.
# MISE_SHOTS_TOKEN=
# Argus vision analyze on gallery publish (one-way POST + inbound gallery index).
# MISE_ARGUS_URL=http://127.0.0.1:<port>
# MISE_ARGUS_TOKEN=
# MISE_ARGUS_TIMEOUT=30
# MISE_ARGUS_ANALYZE_LIMIT=0

# Plutus print upsell (Phase 1) — queued after Argus callback or on publish when Argus off
# MISE_PLUTUS_URL=http://127.0.0.1:<port>
# MISE_PLUTUS_TOKEN=
# MISE_PLUTUS_TIMEOUT=30
# Revenue goal bar on the admin home (whole dollars; 0/unset hides it).
# MISE_MONTHLY_GOAL=0

# ── Nightly durable-file backup ──
# Second location for media/, brand/ and receipts/ — the client originals and
# financial scans, which the SQLite snapshot does NOT cover. Unset = that stage
# skips loudly and only the database is backed up. Point it at a SEPARATE disk:
# the same filesystem survives a wrong delete but not the disk dying, and the
# script warns nightly when it detects that.
# MISE_FILE_BACKUP_DIR=/mnt/backup/mise
# Refuse to run the file stage below this much free space (GB).
# MISE_FILE_BACKUP_MIN_FREE_GB=5

# ── Hot-path write relief ──
# How stale visitors.last_seen may get before a request refreshes it (seconds).
# Every thumbnail request used to rewrite it — 60 serialized writes per gallery
# load, on the rate-limit-exempt hot path, for a column nothing reads.
# MISE_VISITOR_LAST_SEEN_DEBOUNCE_SECONDS=600
#
# SQLite durability. NORMAL is the standard WAL pairing: commits stop fsyncing
# individually and flush at checkpoint. A process crash/restart is still safe;
# an OS crash or power cut can lose the most recent commits. Set FULL to restore
# fsync-per-commit without a deploy. Only NORMAL and FULL are accepted.
# MISE_SQLITE_SYNCHRONOUS=NORMAL

# ── HSTS ──
# Seconds; sent only when the site knows it is on TLS. Default 15552000 (180d),
# root-only (no includeSubDomains/preload). Ratcheting this is hard to undo: a
# browser that cached a long max-age will not reach the site in plaintext for
# that long. Confirm TLS holds before raising. ops/TRUTHFUL-HTTPS.md
# MISE_HSTS_MAX_AGE=15552000

# ── Google review engine ──
# The direct "write a review" link from your Google Business Profile share
# button. Unset = no review asks are ever sent. A warm email goes to each
# gallery's client a few days after delivery, one-shot per gallery, with a
# per-client cooldown so nobody is asked twice in six months. The unhappy are
# invited to reply privately instead — route delight to Google, friction to
# your inbox.
# MISE_GOOGLE_REVIEW_URL=
# MISE_REVIEW_ASK_DAYS=3
# MISE_REVIEW_COOLDOWN_DAYS=180

# ── Anniversary nudges ──
# Days after a client's latest project closes before Kevin gets the "invite
# them back" Telegram line (~11 months, timed before the year mark). Nudges go
# to Kevin only — no client is ever auto-emailed. Needs Telegram configured.
# MISE_ANNIVERSARY_NUDGE_DAYS=335

# ── Pay-to-book ──
# Minutes an unpaid booking hold keeps its slot before it releases (exact —
# conflict queries ignore older holds; the hourly sweep just tidies the rows).
# The fee itself is per event type, set in Admin → Scheduling.
# MISE_BOOKING_PAY_TTL_MIN=30

# ── Admin session lifetime ──
# Admin sessions expire far sooner than client gallery cookies (90d). 90 days is
# right for a client browsing their own photos; applied to admin it meant one
# stolen laptop session stayed valid for a quarter. Seconds; default 14 days.
# MISE_ADMIN_SESSION_MAX_AGE=1209600

# ── /healthz detail ──
# Unlocks the FULL /healthz payload (disk, backup age, queue depth) for
# `Authorization: Bearer <token>`. Unset = the detail is unreachable over HTTP
# and everyone gets the public `{"ok": true}` / 503 `{"ok": false}`; the same
# facts stay visible in Admin → Settings. Anonymous callers never see it either
# way — it is reconnaissance, and a progress meter during a DoS attempt.
# MISE_HEALTHZ_TOKEN=

# ── Off-host DR (stage 3, restic) ──
# Encrypted nightly push to somewhere that is not this host. Client-side
# encryption, so the provider never holds readable photos or client data. Unset
# = the job skips loudly and this host has NO off-host copy. Full runbook:
# ops/DR.md — including the step people miss: keep the password and provider
# credentials OFF this machine, or losing the host loses the backup too.
# RESTIC_REPOSITORY=b2:bucket-name:mise
# RESTIC_PASSWORD_FILE=/opt/mise/.restic-password
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# MISE_OFFSITE_KEEP_DAILY=14
# MISE_OFFSITE_KEEP_WEEKLY=8
# MISE_OFFSITE_KEEP_MONTHLY=12

# ── Dead-man's switches (external monitoring) ──
# Every other alarm here originates on this host, so a dead host/tunnel/process
# is silent. These invert that: we ping out, and the external service alerts on
# the ABSENCE of a ping. Use TWO separate checks — a shared one would let the
# hourly app ping mask a nightly backup that silently stopped. Deliberately not
# gated on Telegram. Full runbook: ops/MONITORING.md
# MISE_HEARTBEAT_PING_URL=      # pinged once per scheduler tick (hourly)
# MISE_BACKUP_PING_URL=         # pinged after a successful nightly backup
# MISE_OFFSITE_PING_URL=        # pinged after a successful off-host push (ops/DR.md)
# MISE_RESTORE_VERIFY_PING_URL= # pinged after a successful monthly restore-verify

# ── Operator alerting (Telegram) ──
# Unset = the WHOLE ops heartbeat is dormant, not just the chat message:
# app/ops_monitor.py returns before it runs a single check, so a stale backup,
# a disk filling up, a crash loop, and a wedged job queue all go unreported.
# /healthz still answers, so an external uptime monitor is the other half of
# this (nothing on the host can report the host being down).
# MISE_TELEGRAM_TOKEN=
# MISE_TELEGRAM_CHAT_ID=
# Thresholds the heartbeat compares against (defaults shown).
# MISE_BACKUP_STALE_HOURS=26
# MISE_JOB_STUCK_AFTER_SECONDS=900
